# Database
DATABASE_URL=postgresql+asyncpg://aries:aries@localhost:5432/aries

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# OpenAI
OPENAI_API_KEY=sk-...

# GNews
GNEWS_API_KEY=...
GNEWS_RATE_LIMIT=100              # Max articles to fetch per day (default: 100)

# Worker
WORKER_SLEEP_SECONDS=2            # Seconds between AI analysis jobs (default: 2)
